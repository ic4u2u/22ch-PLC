# ACSC 24채널 특수가스 스마트 관제 시스템 환경변수 예시 (.env.local로 복사 후 사용)
# 시뮬레이션 시: PLC_IP=127.0.0.1 / 현장 운영 시: PLC_IP=192.168.0.50
PLC_PROTOCOL=MODBUS
PLC_IP=127.0.0.1
PLC_MODBUS_PORT=8502
PLC_XGT_PORT=2004
BRIDGE_PORT=4000
NEXT_PUBLIC_BRIDGE_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
