# ==============================================================================
# ACSC 22채널(11뱅크) 특수가스 스마트 관제 시스템 — 환경변수 설정 예시 (.env.example)
# 사용법: 이 파일을 복사하여 `.env.local` 이름으로 저장한 뒤 실제 현장 값을 입력하세요.
# 주의: `.env.local` 파일은 민감 정보를 담고 있으므로 절대 Git에 커밋하지 마세요!
# ==============================================================================

# 1. PLC 통신 설정 ("MODBUS" 또는 "XGT")
PLC_PROTOCOL=MODBUS
PLC_IP=127.0.0.1
PLC_MODBUS_PORT=8502
PLC_XGT_PORT=2004

# 2. 중앙 WebSocket & REST 브릿지 서버 포트
BRIDGE_PORT=4000

# 3. 관리자 인증 시크릿 키 (미설정 시 logs/.auth_secret에 32바이트 난수 자동 생성·격리)
ACSC_AUTH_SECRET=
# 최초 DB 초기화 시 적용할 관리자 PIN (4~6자리 숫자, 기동 즉시 단방향 암호화 해싱 저장됨)
INITIAL_ADMIN_PIN=1234

# 4. USB 3색 타워램프 시리얼 포트 (AUTO 또는 COM3 등)
LAMP_USB_PORT=AUTO

# 5. 텔레그램 실시간 위험 경보 알림 (선택 사항)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
