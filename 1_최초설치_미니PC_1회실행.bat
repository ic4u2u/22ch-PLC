@echo off
chcp 65001 > nul
title [1단계] 미니PC 최초 1회 설치 (22채널 가스 모니터링 시스템)
cd /d "%~dp0"
echo =====================================================================
echo   [1단계] 특수가스 22채널 모니터링 시스템 최초 설치를 시작합니다.
echo   ※ 인터넷이 연결된 상태에서 딱 1번만 실행하시면 됩니다.
echo =====================================================================
echo.
where node >nul 2>nul
if errorlevel 1 (
  echo [오류] Node.js가 설치되어 있지 않습니다!
  echo 먼저 https://nodejs.org/ko 에서 LTS 버전을 설치한 뒤 다시 실행해 주세요.
  echo.
  pause
  exit /b 1
)
echo [진행중] 필요한 프로그램 패키지를 설치합니다 (약 1~2분 소요)...
call npm install
if errorlevel 1 (
  echo.
  echo [오류] 설치 중 문제가 발생했습니다. 인터넷 연결 상태를 확인해 주세요.
  pause
  exit /b 1
)
echo.
echo [진행중] 오프라인 즉시 실행용 화면 빌드(.next)를 생성합니다...
call npm run build
if errorlevel 1 (
  echo.
  echo [경고] 프로덕션 빌드에 실패했습니다. (테스트 모드에서는 계속 동작 가능합니다)
)
echo.
echo =====================================================================
echo   [설치 완료!] 이제 네트워크가 없는 현장에서도
echo   [2_시뮬레이션모드], [3_현장실물PLC연결], [4_무설치_오프라인_USB_현장실행]을
echo   더블클릭해서 바로 테스트하실 수 있습니다.
echo =====================================================================
pause
